__pycache__/
*.pyc
venv/
.env

# Runtime-written demand-factory stores — captured on the production box by live
# taps, NOT authored in the repo. Tracking them would let a repo->box auto-pull
# overwrite accumulated live demand/queue state on every commit. The spine
# (skus.json, cards/, registries) IS tracked — it's authored state flowing
# down; these flow up (via a future reader/dashboard), never through git.
data/demand_log.jsonl
data/review_queue.json
# Captured used-market prices — refreshed on the box, overlaid at build time.
# Same captured-state rationale as the two above: tracking it would let a
# repo->box auto-pull clobber the box's fresh prices. The card spine stays
# tracked; prices live here, gitignored.
data/used_prices.json
