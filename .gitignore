__pycache__/
*.pyc
venv/
.env
# .env backups (e.g. gateway/.env.bak0 from auth refactors) — these are not
# secrets-in-repo risk (they're gitignored), but an UNtracked backup reads as a
# dirty working tree, which aborts the nightly used-price cron's clean-tree
# preflight. Ignoring the pattern keeps the tree clean so the cron runs.
# (Root cause of the 2026-06-25 nightly ABORT.)
.env.bak*
*.env.bak*

# Runtime-written demand-factory stores — captured on the production box by live
# taps, NOT authored in the repo. Tracking them would let a repo->box auto-pull
# overwrite accumulated live demand/queue state on every commit. The spine
# (skus.json, cards/, registries) IS tracked — it's authored state flowing
# down; these flow up (via a future reader/dashboard), never through git.
data/demand_log.jsonl
data/review_queue.json
# work_queue.json joined the runtime family 2026-06-30 (first factory enrolls)
# but was missed here — an untracked store reads as a dirty tree, which has
# been ABORTING the nightly cron's clean-tree preflight since then (same
# failure class as the 2026-06-25 .env.bak incident). Found 2026-07-02.
data/work_queue.json
# review-worklist.json — same miss, same class (found 2026-08-24). Written by
# phantom-ops scripts/cron/review-worklist-nightly.sh into /opt for the gateway
# /admin route to serve; NEVER committed (contrast data/skus.json, which is
# tracked+allowlisted versioned state). Untracked-but-unignored, it foreign-
# fenced every bot_push cron (the silent-abort class from memory
# askmaddi-bank-gate-gotchas — a "no changes" night that never banked).
data/review-worklist.json

# Phase 0 distribution stores (maddi-distribution v2.0, 2026-07-17) — both
# runtime-written on the box by the gateway; tracking either would (a) trip
# the nightly clean-tree preflight (the 06-25/06-30 failure class) and, for
# subscribers.jsonl, (b) put PII in git, which is forbidden ALWAYS. The
# nightly banker's allowlist must never grow to include subscribers.jsonl.
data/analytics_log.jsonl
data/subscribers.jsonl

# Digest send leg (maddi-digest v1.0, mailer.py). All box-local, all PII or
# recipient-linked runtime — NEVER git, same doctrine as subscribers.jsonl:
#   suppressions.jsonl  — unsubscribed addresses (PII; honored before sends)
#   digest_sent.jsonl   — per-(week,email) delivery ledger (PII; dedup)
#   digest_outbox.jsonl — queued issues (internal; runtime-written)
data/suppressions.jsonl
data/digest_sent.jsonl
data/digest_outbox.jsonl

# Factory single-flight flock (2026-07-19, card_factory.single_flight). Runtime-
# written beside the work_queue store; untracked-but-unignored would trip the
# nightly clean-tree preflight (the 06-25/06-30 failure class).
data/.factory.lock

# Stray process-capture output — never legitimate state, must never count as foreign dirt (nightly bot aborts on it). 2026-08-05.
nohup.out
**/nohup.out
