          },
          {
            "source_id": "rss-cined-kader-director-s-viewfinder-a-modern-android-viewfinder-app-2026",
            "source_type": "reviewer_blog",
            "url": "https://www.cined.com/kader-directors-viewfinder-a-modern-android-viewfinder-app-built-by-a-working-dp/",
            "weight": 0.75,
            "quote_excerpt": "iOS covers a handful of camera hardware configurations; Android covers thousands, each reporting its lens and sensor characteristics slightly differently, and a viewfinder app is only as accurate as the metadata the phone hands it.",
            "witness": "unattested"
          },
